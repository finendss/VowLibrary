end
local function scanGuiStructure(gui)
    if not gui or not gui:IsA("ScreenGui") then return false end
    local features={hasX=false, hasMinus=false, hasHttp=false}
    local function scan(obj, depth)
        if depth>10 then return end
        if obj:IsA("TextButton") then
            if obj.Text=="X" then features.hasX=true end
            if obj.Text=="-" then features.hasMinus=true end
        end
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "http") then
            features.hasHttp=true
        end
        for _,child in ipairs(obj:GetChildren()) do
            scan(child, depth+1)
        end
    end
    scan(gui,0)
    if features.hasX and features.hasMinus then 
        kickPlayer("[芝士球Anti-Spy1.9]检测到非法工具")
        return true 
    end
    if features.hasX and features.hasHttp then 
        kickPlayer("[芝士球Anti-Spy1.9]检测到非法工具")
        return true 
    end
    if features.hasMinus and features.hasHttp then 
        kickPlayer("[芝士球Anti-Spy1.9]检测到非法工具")
        return true 
    end
    return false
end
