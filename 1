    if lower:find("httpspy") or lower:find("ketamine") then return true end
    if lower:find("httpgetfolder") or lower:find("webhookfolder") then return true end
    if lower:find("requestfolder") or lower:find("loadstringfolder") then return true end
    if lower:find("captured_scripts") then return true end
    if lower:find("响应") or lower:find("请求") then return true end
    if lower:find("loadstring") then return true end
    if lower:find("httpgetlog") then return true end
    if lower:find("log") and lower:find(".txt") then return true end
