        local env = getgenv()
        if env.saveResponse or env.saveRequest then
            kickPlayer("[芝士球Anti-Spy1.21]检测到非法工具")
            return true
        end
        if env.isCapturing ~= nil or env.responseCount ~= nil then
            kickPlayer("[芝士球Anti-Spy1.21]检测到非法工具")
            return true
        end
    end
    if _G.saveResponse or _G.saveRequest then
        kickPlayer("[芝士球Anti-Spy1.21]检测到非法工具")
        return true
    end
    return false
end

