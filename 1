local function checkSuspiciousHooks()
    if isfunctionhooked then
        local funcs={
            {name="identifyexecutor", func=identifyexecutor},
            {name="IsInGroup", func=game:GetService("Players").LocalPlayer.IsInGroup},
            {name="Kick", func=game:GetService("Players").LocalPlayer.Kick},
            {name="loadstring", func=loadstring},
            {name="HttpGet", func=game.HttpGet},
            {name="HttpPost", func=game.HttpPost},
            {name="syn.request", func=(syn or {}).request},
            {name="http.request", func=(http or {}).request}
        }
        for _,item in ipairs(funcs) do
            if type(item.func)=="function" and isfunctionhooked(item.func) then
                kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
                return true
            end
        end
    end
    if identifyexecutor then
        local result=pcall(identifyexecutor)
        if result and type(result)=="string" and result:find("狗屎") then
            kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
            return true
        end
    end
    return false
end

local SPY_VARIABLES={
    "HttpSpy","__KetamineShared","Ketamine","CSpy","RSpy","ESpy",
    "Httpspy","sb",
    "interceptHttp","LoggedRequests","spyActive","HookActive",
    "logHttp","CSpyObjects","_spyEnabled","HttpLogs",
    "SidePanelEvent","httpRequests","_httpSpy",
    "MainTab","ResponseTab","RequestTab","Capture_CodePreview_Window"
}
local function isExactSpyVariable(name)
    if type(name)~="string" then return false end
    for _,spy in ipairs(SPY_VARIABLES) do
        if name==spy then return true end
    end
    return false
end

local SPY_GUI_NAMES={"HttpSpyGui","Ketamine","HttpSpy","Httpspy","sb","Capture_CodePreview_Window"}
local function isSpyGuiName(name)
    if type(name)~="string" then return false end
    for _,gui in ipairs(SPY_GUI_NAMES) do
        if name==gui then return true end
    end
    return false
end

local function scanGuiStructure(gui)
    if not gui or not gui:IsA("ScreenGui") then return false end
    local features={hasX=false, hasMinus=false, hasHttp=false}
    local function scan(obj, depth)
        if depth>10 then return end
        if obj:IsA("TextButton") then
            if obj.Text=="X" then features.hasX=true end
            if obj.Text=="-" then features.hasMinus=true end
        end
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "http") then
            features.hasHttp=true
        end
        for _,child in ipairs(obj:GetChildren()) do
            scan(child, depth+1)
        end
    end
    scan(gui,0)
    if features.hasX and features.hasMinus then 
        pcall(function() gui:Destroy() end)
        kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
        return true 
    end
    if features.hasX and features.hasHttp then 
        pcall(function() gui:Destroy() end)
        kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
        return true 
    end
    if features.hasMinus and features.hasHttp then 
        pcall(function() gui:Destroy() end)
        kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
        return true 
    end
    return false
end

local function fullScan()
    local envs={_G}
    if getgenv then table.insert(envs,getgenv()) end
    if getfenv then table.insert(envs,getfenv()) end
    for _,env in ipairs(envs) do
        if type(env)=="table" then
            for key,_ in pairs(env) do
                if type(key)=="string" and isExactSpyVariable(key) then
                    kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
                    return true
                end
            end
        end
    end
    local containers={}
    local c=game:GetService("CoreGui") if c then table.insert(containers,c) end
    local p=game:GetService("Players").LocalPlayer
    if p then local pg=p:FindFirstChild("PlayerGui") if pg then table.insert(containers,pg) end end
    if getfenv().gethui then local h=getfenv().gethui() if h and not table.find(containers,h) then table.insert(containers,h) end end
    for _,container in ipairs(containers) do
        for _,child in ipairs(container:GetChildren()) do
            if child:IsA("ScreenGui") then
                if isSpyGuiName(child.Name) then 
                    pcall(function() child:Destroy() end)
                    kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
                    return true 
                end
                if scanGuiStructure(child) then 
                    return true 
                end
            end
        end
    end
    if checkSuspiciousHooks() then 
        return true 
    end
    return false
end

fullScan()

