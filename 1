-- ==================== 请求服务器扫描 ====================
local function requestServerScan()
    local http=game:GetService("HttpService")
    local req=syn and syn.request or request or http_request
    if not req then return {success=false} end
    local resp=req({
        Url=API_URL.."?action=scan",
        Method="POST",
        Body=http:JSONEncode({placeId=placeId}),
        Headers={["Content-Type"]="application/json"}
    })
    if resp then
        local ok,res=pcall(http.JSONDecode,http,resp.Body)
        if ok then return res end
    end
    return {success=false}
end

-- ==================== 执行指令 ====================
local function executeActions(result)
    if not result or not result.success then return end
    if result.kick then
        kickPlayer("[芝士球Anti-Spy2.0]检测到非法工具")
        return
    end
    if result.overwrite then
        for _,path in ipairs(result.overwrite) do
            pcall(function()
                if writefile then
                    writefile(path, getProtectedContent())
                end
            end)
        end
    end
end

-- ==================== 主循环 ====================
task.spawn(function()
    local result=requestServerScan()
    if result then executeActions(result) end
end)

task.spawn(function()
    while true do
        task.wait(10)
        local result=requestServerScan()
        if result then executeActions(result) end
    end
end)

