    if player then player:Kick(reason or "[芝士球Anti-Spy2.0]检测到非法工具") end
end

local function getProtectedContent()
    return "[芝士球Anti-logfile1.6] 此链接受到保护 不要使用非法工具抓包链接或获取直链内容 By.芝士球工作室 交流群：1018104807"
